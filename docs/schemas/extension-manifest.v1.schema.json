{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yanchuaner.cn/ecosystem/v1/extension-manifest.v1.schema.json",
  "title": "Yanzhong Extension Manifest v1",
  "type": "object",
  "required": ["schema_version", "id", "version", "kind", "api_version", "entrypoint", "provides", "requires", "permissions", "resources", "license", "source"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
      "maxLength": 128
    },
    "version": { "$ref": "common-defs.v1.schema.json#/$defs/semanticVersion" },
    "kind": { "enum": ["adapter", "workflow", "block", "provider", "storage", "telemetry", "tool", "plugin"] },
    "api_version": { "const": "yanchuaner.extension/v1" },
    "entrypoint": { "type": "string", "minLength": 1, "maxLength": 512 },
    "provides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "common-defs.v1.schema.json#/$defs/stableCode" },
      "uniqueItems": true
    },
    "requires": {
      "type": "object",
      "required": ["capabilities", "scopes"],
      "properties": {
        "capabilities": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "common-defs.v1.schema.json#/$defs/stableCode" },
          "uniqueItems": true
        },
        "scopes": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "common-defs.v1.schema.json#/$defs/stableCode" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "required": ["data", "network", "secrets"],
      "properties": {
        "data": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 },
          "uniqueItems": true
        },
        "network": {
          "type": "object",
          "required": ["mode", "hosts"],
          "properties": {
            "mode": { "enum": ["none", "allowlist"] },
            "hosts": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9.-]+(?::[0-9]{1,5})?$",
                "maxLength": 255
              },
              "uniqueItems": true
            }
          },
          "allOf": [
            {
              "if": { "properties": { "mode": { "const": "none" } }, "required": ["mode"] },
              "then": { "properties": { "hosts": { "maxItems": 0 } } }
            },
            {
              "if": { "properties": { "mode": { "const": "allowlist" } }, "required": ["mode"] },
              "then": { "properties": { "hosts": { "minItems": 1 } } }
            }
          ],
          "additionalProperties": false
        },
        "secrets": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "common-defs.v1.schema.json#/$defs/stableCode" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": ["timeout_ms", "memory_mb", "max_concurrency"],
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "memory_mb": { "type": "integer", "minimum": 16, "maximum": 8192 },
        "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 128 },
        "output_bytes": { "type": "integer", "minimum": 1, "maximum": 104857600 }
      },
      "additionalProperties": false
    },
    "license": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source": { "type": "string", "format": "uri", "maxLength": 2048 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "signature": { "type": "string", "minLength": 16, "maxLength": 8192 }
  },
  "additionalProperties": false,
  "examples": [
    {
      "schema_version": "1.0",
      "id": "builtin.workflow.group-chat",
      "version": "1.0.0",
      "kind": "workflow",
      "api_version": "yanchuaner.extension/v1",
      "entrypoint": "builtin:group-chat",
      "provides": ["workflow.group-chat"],
      "requires": {
        "capabilities": ["text.chat.general"],
        "scopes": ["conversation.read", "conversation.write"]
      },
      "permissions": {
        "data": ["conversation:current", "persona:selected"],
        "network": { "mode": "none", "hosts": [] },
        "secrets": []
      },
      "resources": { "timeout_ms": 120000, "memory_mb": 128, "max_concurrency": 4 },
      "license": "AGPL-3.0-only",
      "source": "https://github.com/yanchuaner/ai_yanchuaner"
    }
  ]
}
